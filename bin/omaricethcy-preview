#!/usr/bin/env python3
"""Build the preview.png that the theme picker shows.

    omaricethcy-preview [theme...]

Every stock Omarchy theme ships one and the picker looks empty without it. This
composes one from the theme's own assets — wallpaper, ramp, semantic colours —
rather than screenshotting the desktop, so it is reproducible and carries none
of the screen's contents.
"""

import argparse
import pathlib
import re
import subprocess
import sys

REPOSITORY = pathlib.Path(__file__).resolve().parent.parent
WIDTH, HEIGHT = 1800, 1012
STRIP_HEIGHT = 210
SWATCH_WIDTH, SWATCH_HEIGHT = 118, 52

COLOR_LINE = re.compile(r'^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"(#[0-9a-fA-F]{6})"')

# ImageMagick font names differ per machine, so ask it what it has instead of
# hardcoding one. Ordered by preference; the last entry is always installed.
FONT_PREFERENCES = ("FiraCode-Nerd-Font-Mono", "JetBrainsMono-Nerd-Font-Mono",
                    "DejaVu-Sans-Mono-for-Powerline", "DejaVu-Sans-Mono", "Helvetica")


def available_fonts():
    listing = subprocess.run(
        ["magick", "-list", "font"], capture_output=True, text=True, check=True
    ).stdout
    return {line.split(":", 1)[1].strip() for line in listing.splitlines() if "Font:" in line}


def resolve_fonts():
    fonts = available_fonts()
    regular = bold = None
    for candidate in FONT_PREFERENCES:
        if regular is None and candidate in fonts:
            regular = candidate
        if bold is None and f"{candidate}-Bold" in fonts:
            bold = f"{candidate}-Bold"
        if regular and bold:
            break
    regular = regular or "Helvetica"
    return regular, bold or regular


def read_palette(theme_dir):
    colors = {}
    for line in (theme_dir / "colors.toml").read_text().splitlines():
        match = COLOR_LINE.match(line)
        if match:
            colors[match.group(1).lower()] = match.group(2)
    return colors


def pick_backdrop(theme_dir):
    """Prefer a landscape variant; the previews are landscape."""
    for directory in ("landscape", "backgrounds"):
        candidates = sorted(
            path for path in (theme_dir / directory).glob("*")
            if path.suffix.lower() in (".jpg", ".jpeg", ".png")
            and "verloop" not in path.stem and "kern" not in path.stem
        )
        if candidates:
            return candidates[0]
    return None


def build(theme_dir, name, fonts):
    regular_font, bold_font = fonts
    colors = read_palette(theme_dir)
    if not colors:
        print(f"{name}: no colors.toml, skipping", file=sys.stderr)
        return False

    background = colors.get("background", "#181716")
    foreground = colors.get("foreground", "#ede4c8")
    accent = colors.get("accent", foreground)

    # Accent ramp and neutrals only. The semantic red and green exist in the
    # palette so errors and diffs stay readable, but they are not what either
    # theme looks like, and a swatch row led by a green chip advertises a colour
    # the desktop never shows. color3 is the accent, so it is not repeated.
    ramp = [colors[f"color{index}"] for index in (5, 4, 6) if f"color{index}" in colors]
    neutrals = [colors.get(key) for key in ("color7", "color8")]
    swatches = [accent] + ramp + [value for value in neutrals if value]

    backdrop = pick_backdrop(theme_dir)
    command = ["magick"]
    if backdrop:
        command += [
            str(backdrop),
            "-resize", f"{WIDTH}x{HEIGHT}^", "-gravity", "center",
            "-extent", f"{WIDTH}x{HEIGHT}", "-modulate", "58",
        ]
    else:
        command += ["-size", f"{WIDTH}x{HEIGHT}", f"xc:{background}"]

    strip_top = HEIGHT - STRIP_HEIGHT
    command += [
        "-fill", f"{background}E8", "-stroke", "none",
        "-draw", f"rectangle 0,{strip_top} {WIDTH},{HEIGHT}",
        "-fill", accent,
        "-draw", f"rectangle 0,{strip_top} {WIDTH},{strip_top + 4}",
    ]

    command += [
        # -annotate honours gravity, and it is still `center` from the resize above.
        "-gravity", "NorthWest",
        "-font", bold_font, "-pointsize", "62", "-fill", accent,
        "-annotate", f"+64+{strip_top + 44}", name,
        "-font", regular_font, "-pointsize", "26", "-fill", f"{foreground}B0",
        "-annotate", f"+64+{strip_top + 130}", f"{accent}  ·  omaricethcy",
    ]

    swatch_top = strip_top + 120
    swatch_left = WIDTH - 64 - len(swatches) * (SWATCH_WIDTH + 10) + 10
    for index, value in enumerate(swatches):
        left = swatch_left + index * (SWATCH_WIDTH + 10)
        command += [
            "-fill", value, "-stroke", "none",
            "-draw", f"roundrectangle {left},{swatch_top} "
                     f"{left + SWATCH_WIDTH},{swatch_top + SWATCH_HEIGHT} 8,8",
        ]

    output = theme_dir / "preview.png"
    command += ["-quality", "92", str(output)]
    subprocess.run(command, check=True)
    print(f"  wrote {output.relative_to(REPOSITORY)}")
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("themes", nargs="*", help="theme names; default is all of them")
    arguments = parser.parse_args()

    names = arguments.themes or sorted(
        path.name for path in (REPOSITORY / "themes").iterdir() if path.is_dir()
    )
    fonts = resolve_fonts()
    for name in names:
        theme_dir = REPOSITORY / "themes" / name
        if not theme_dir.is_dir():
            print(f"no such theme: {name}", file=sys.stderr)
            continue
        print(name)
        build(theme_dir, name, fonts)


if __name__ == "__main__":
    main()
