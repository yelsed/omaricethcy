#!/usr/bin/env python3
"""Render a word as an ASCII banner, and as a PNG of that banner.

    omaricethcy-ascii goud
    omaricethcy-ascii --all

Writes per theme:

    ascii/logo.txt      the banner, plain text — fastfetch logo, shell greeting
    ascii/logo.widths   the column each letter ends at, for the lock screen
    unlock.png          the banner drawn in the accent colour, wide and short,
                        for the Plymouth boot logo and the SDDM login screen

No figlet on this system and none worth adding as a dependency, so the letter
forms live here. Only the characters theme names need are defined; anything
missing falls back to a filled block so a new name still produces something.
"""

import argparse
import pathlib
import shutil
import subprocess
import re
import sys

REPOSITORY = pathlib.Path(__file__).resolve().parent.parent

# Six rows per glyph. Chosen to read as solid slab letters at terminal size.
GLYPHS = {
    "A": ["▄▀▀▀▄", "█▄▄▄█", "█   █", "█   █", "▀   ▀", "     "],
    "B": ["█▀▀▄ ", "█▄▄▀ ", "█  █ ", "█▄▄▀ ", "▀▀▀  ", "     "],
    "C": ["▄▀▀▀▄", "█    ", "█    ", "█▄▄▄▄", " ▀▀▀▀", "     "],
    "D": ["█▀▀▄ ", "█  █ ", "█  █ ", "█▄▄▀ ", "▀▀▀  ", "     "],
    "E": ["█▀▀▀▀", "█▄▄▄ ", "█    ", "█▄▄▄▄", "▀▀▀▀▀", "     "],
    "F": ["█▀▀▀▀", "█▄▄▄ ", "█    ", "█    ", "▀    ", "     "],
    "G": ["▄▀▀▀▄", "█    ", "█ ▀█ ", "█▄▄█ ", " ▀▀▀ ", "     "],
    "H": ["█   █", "█▄▄▄█", "█   █", "█   █", "▀   ▀", "     "],
    "I": ["▀█▀", " █ ", " █ ", "▄█▄", "▀▀▀", "   "],
    "J": ["   █", "   █", "   █", "█▄▄█", " ▀▀ ", "    "],
    "K": ["█  ▄▀", "█▄▀  ", "█▀▄  ", "█  ▀▄", "▀   ▀", "     "],
    "L": ["█    ", "█    ", "█    ", "█▄▄▄▄", "▀▀▀▀▀", "     "],
    "M": ["█▄ ▄█", "█ ▀ █", "█   █", "█   █", "▀   ▀", "     "],
    "N": ["█▄  █", "█ ▀▄█", "█  ▀█", "█   █", "▀   ▀", "     "],
    "O": ["▄▀▀▀▄", "█   █", "█   █", "▀▄▄▄▀", " ▀▀▀ ", "     "],
    "P": ["█▀▀▄ ", "█▄▄▀ ", "█    ", "█    ", "▀    ", "     "],
    "R": ["█▀▀▄ ", "█▄▄▀ ", "█ ▀▄ ", "█  ▀▄", "▀   ▀", "     "],
    "S": ["▄▀▀▀▀", "▀▄▄▄ ", "    █", "▀▄▄▄▀", " ▀▀▀ ", "     "],
    "T": ["▀▀█▀▀", "  █  ", "  █  ", "  █  ", "  ▀  ", "     "],
    "U": ["█   █", "█   █", "█   █", "▀▄▄▄▀", " ▀▀▀ ", "     "],
    "V": ["█   █", "█   █", "▀▄ ▄▀", " ▀▄▀ ", "  ▀  ", "     "],
    "W": ["█   █", "█   █", "█ ▄ █", "▀▄▀▄▀", " ▀ ▀ ", "     "],
    "X": ["▀▄ ▄▀", " ▀▄▀ ", " ▄▀▄ ", "▄▀ ▀▄", "▀   ▀", "     "],
    "Y": ["█   █", "▀▄ ▄▀", " ▀█▀ ", "  █  ", "  ▀  ", "     "],
    "Z": ["▀▀▀▀█", "   ▄▀", " ▄▀  ", "█▄▄▄▄", "▀▀▀▀▀", "     "],
    "-": ["     ", "     ", "▄▄▄▄▄", "     ", "     ", "     "],
    " ": ["   ", "   ", "   ", "   ", "   ", "   "],
}
FALLBACK = ["█████", "█████", "█████", "█████", "▀▀▀▀▀", "     "]
ROWS = 6
BLOCK = "█"


# Doubling a row is not a matter of printing it twice: a half block fills half a
# cell, so at twice the size it fills one whole cell and leaves the next empty.
DOUBLED = {"█": ("█", "█"), "▀": ("█", " "), "▄": (" ", "█"), " ": (" ", " ")}


def scale_glyph(glyph, factor):
    """Enlarge a glyph by a whole factor, keeping the half-block shapes honest."""
    if factor == 1:
        return glyph
    rows = []
    for line in glyph:
        widened = "".join(character * factor for character in line)
        top = "".join(DOUBLED.get(character, (character, character))[0] for character in line)
        bottom = "".join(DOUBLED.get(character, (character, character))[1] for character in line)
        top = "".join(character * factor for character in top)
        bottom = "".join(character * factor for character in bottom)
        rows.extend([top] + [widened] * (factor - 2) + [bottom] if factor > 2 else [top, bottom])
    return rows


def banner(word, scale=1):
    glyphs = [scale_glyph(GLYPHS.get(character.upper(), FALLBACK), scale) for character in word]
    height = len(glyphs[0]) if glyphs else ROWS
    # The gap between letters is scaled along with them. Left at one cell it
    # stays hairline while the strokes get thicker, and the word closes up.
    gap = " " * scale
    rows = [gap.join(glyph[row] for glyph in glyphs).rstrip() for row in range(height)]
    # The glyphs carry a blank row for descender spacing, which scaling
    # multiplies. Empty rows cost a wasted hyprlock label each, so drop them.
    while rows and not rows[-1].strip():
        rows.pop()
    return rows


def letter_boundaries(word, scale=1):
    """Column each letter ends at, so a reveal can step one letter at a time.

    The banner is stored as flat lines, which cannot be split back into glyphs
    without knowing the widths, so they are written out alongside it."""
    glyphs = [scale_glyph(GLYPHS.get(character.upper(), FALLBACK), scale) for character in word]
    boundaries, column = [], 0
    for index, glyph in enumerate(glyphs):
        column += len(glyph[0]) + (scale if index else 0)
        boundaries.append(column)
    return boundaries


def read_palette(theme_dir):
    colors = {}
    pattern = re.compile(r'^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"(#[0-9a-fA-F]{6})"')
    for line in (theme_dir / "colors.toml").read_text().splitlines():
        match = pattern.match(line)
        if match:
            colors[match.group(1).lower()] = match.group(2)
    return colors


def cell_grid(lines, accent, background):
    """One pixel per banner cell, as a PAM for ImageMagick to read on stdin.

    Not drawn as text: a font lays a block character out on its own advance and
    line height, and neither is exactly one cell, so the blocks fail to tile and
    the word arrives full of seams and half-row shifts. A pixel per cell has no
    metrics to disagree with."""
    def channels(color):
        if color == "none":
            return (0, 0, 0, 0)
        value = color.lstrip("#")
        return tuple(int(value[index:index + 2], 16) for index in (0, 2, 4)) + (255,)

    ink, paper = bytes(channels(accent)), bytes(channels(background))
    columns = max(len(line) for line in lines)

    # Every row becomes two, so the half blocks have somewhere to go and a cell
    # ends up square — a terminal cell is about twice as tall as it is wide, and
    # the letter shapes are drawn expecting that.
    body = bytearray()
    for line in lines:
        padded = line.ljust(columns)
        for half in (0, 1):
            for character in padded:
                filled = DOUBLED.get(character, (character, character))[half] == BLOCK
                body += ink if filled else paper

    header = (f"P7\nWIDTH {columns}\nHEIGHT {len(lines) * 2}\nDEPTH 4\nMAXVAL 255\n"
              f"TUPLTYPE RGB_ALPHA\nENDHDR\n").encode()
    return header + bytes(body), columns, len(lines) * 2


def draw(lines, accent, background, output, cell_pixels, width=None, height=None):
    """Blow the cell grid up with nearest-neighbour, so the edges stay hard."""
    grid, columns, rows = cell_grid(lines, accent, background)

    if width and height:
        # Fit the plate with a whole number of pixels per cell, or the blocks
        # land on fractional boundaries and the letters blur back together.
        padding = round(height * 0.12)
        cell_pixels = max(1, min((width - 2 * padding) // columns,
                                 (height - 2 * padding) // rows))
    scaled = f"{columns * cell_pixels}x{rows * cell_pixels}"

    command = ["magick", "pam:-", "-filter", "point", "-resize", f"{scaled}!"]
    if width and height:
        command += ["-gravity", "center", "-background", background,
                    "-extent", f"{width}x{height}"]
    subprocess.run(command + [str(output)], input=grid, check=True)


def build(theme_dir, name, scale=2):
    colors = read_palette(theme_dir)
    accent = colors.get("accent", "#e5c125")

    ascii_dir = theme_dir / "ascii"
    ascii_dir.mkdir(exist_ok=True)
    lines = banner(name, scale)

    (ascii_dir / "logo.txt").write_text("\n".join(lines) + "\n")
    print(f"  wrote {(ascii_dir / 'logo.txt').relative_to(REPOSITORY)}")

    boundaries = letter_boundaries(name, scale)
    (ascii_dir / "logo.widths").write_text(" ".join(str(c) for c in boundaries) + "\n")
    print(f"  wrote {(ascii_dir / 'logo.widths').relative_to(REPOSITORY)}")

    if not shutil.which("magick"):
        print("  ImageMagick missing, skipping the PNG", file=sys.stderr)
        return

    # Plymouth wants a wide, short logo; stock Omarchy themes ship 800x188.
    # Transparent, not the theme background: omarchy-plymouth-set passes the
    # background to Plymouth as `printf "%.3f"` floats, and Plymouth truncates
    # them back to bytes, so #181716 is painted as #171615. A baked-in plate
    # would show as a rectangle one value off from the screen behind it.
    draw(lines, accent, "none", theme_dir / "unlock.png", 12, 800, 188)
    print(f"  wrote {(theme_dir / 'unlock.png').relative_to(REPOSITORY)}")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("themes", nargs="*")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--scale", type=int, default=2,
                        help="whole-number size multiplier for the letterforms (default 2)")
    arguments = parser.parse_args()

    names = arguments.themes
    if arguments.all or not names:
        names = sorted(path.name for path in (REPOSITORY / "themes").iterdir() if path.is_dir())

    for name in names:
        theme_dir = REPOSITORY / "themes" / name
        if not theme_dir.is_dir():
            print(f"no such theme: {name}", file=sys.stderr)
            continue
        print(name)
        build(theme_dir, name, arguments.scale)


if __name__ == "__main__":
    main()
