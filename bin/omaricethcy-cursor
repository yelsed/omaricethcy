#!/usr/bin/env python3
"""Build a cursor theme in each theme's accent colour.

    omaricethcy-cursor              every theme
    omaricethcy-cursor goud
    omaricethcy-cursor --list-sizes

Catppuccin's Volantes cursors ship their SVG sources alongside the built
artefacts, and every shape is drawn in exactly two colours: one for the body and
one for the outline. Substituting those two produces a cursor in this rice's own
accent rather than a pastel that nearly matches it.

Two formats come out, because two different consumers read them:

    cursors/        XCursor, the ancient format. XWayland, GTK and Qt read it.
    hyprcursors/    Hyprland's own format, SVG-backed so it stays sharp at any
                    scale. Just a zip per shape, so it is rebuilt by swapping
                    the colours in the SVGs and zipping them back up.

The result is written to ~/.local/share/icons/omaricethcy-<name> rather than
into the theme, since a cursor theme is looked up by name from a fixed set of
directories and cannot live inside an Omarchy theme.
"""

import argparse
import concurrent.futures
import json
import os
import pathlib
import re
import shutil
import struct
import subprocess
import sys
import zipfile

REPOSITORY = pathlib.Path(__file__).resolve().parent.parent
SOURCE = pathlib.Path("/usr/share/icons/catppuccin-mocha-peach-cursors")
INSTALL_ROOT = pathlib.Path(
    os.environ.get("XDG_DATA_HOME", pathlib.Path.home() / ".local/share")) / "icons"

# The two colours every shape in the source theme is drawn with.
SOURCE_BODY = "#fab387"
SOURCE_OUTLINE = "#1e1e2e"

# The nominal sizes the source theme ships. A cursor is rendered at four thirds
# of its nominal size, which is where 24 -> 32 and 72 -> 96 come from.
NOMINAL_SIZES = (12, 18, 24, 30, 36, 42, 48, 54, 60, 66, 72)

XCURSOR_MAGIC = b"Xcur"
XCURSOR_VERSION = 0x00010000
XCURSOR_IMAGE_TYPE = 0xFFFD0002
FILE_HEADER_SIZE = 16
TABLE_ENTRY_SIZE = 12
IMAGE_HEADER_SIZE = 36
DEFAULT_DELAY = 50


def pixel_size(nominal):
    return nominal * 4 // 3


def read_palette(theme_dir):
    colors = {}
    pattern = re.compile(r'^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"(#[0-9a-fA-F]{6})"')
    for line in (theme_dir / "colors.toml").read_text().splitlines():
        match = pattern.match(line)
        if match:
            colors[match.group(1).lower()] = match.group(2)
    return colors


def recolour(text, body, outline):
    for source_color, replacement in ((SOURCE_BODY, body), (SOURCE_OUTLINE, outline)):
        text = re.sub(re.escape(source_color), replacement, text, flags=re.IGNORECASE)
    return text


def render(svg_text, size):
    """Rasterise one SVG at one size and return premultiplied ARGB rows.

    XCursor stores alpha-premultiplied ARGB; every renderer here hands back
    straight RGBA, so the channels are multiplied down before packing."""
    png = subprocess.run(["rsvg-convert", "-w", str(size), "-h", str(size), "-"],
                         input=svg_text.encode(), capture_output=True, check=True).stdout
    raw = subprocess.run(["magick", "png:-", "-depth", "8", "RGBA:-"],
                         input=png, capture_output=True, check=True).stdout

    pixels = bytearray(len(raw))
    for offset in range(0, len(raw), 4):
        red, green, blue, alpha = raw[offset:offset + 4]
        pixels[offset:offset + 4] = bytes((
            blue * alpha // 255, green * alpha // 255, red * alpha // 255, alpha))
    return bytes(pixels)


def image_chunk(nominal, size, hotspot_x, hotspot_y, delay, pixels):
    return struct.pack("<IIIIIIIII", IMAGE_HEADER_SIZE, XCURSOR_IMAGE_TYPE, nominal, 1,
                       size, size, hotspot_x, hotspot_y, delay) + pixels


def xcursor_file(chunks):
    """Assemble the chunks into an XCursor file, which is a table of contents of
    absolute offsets followed by the chunks themselves."""
    position = FILE_HEADER_SIZE + TABLE_ENTRY_SIZE * len(chunks)
    table, body = bytearray(), bytearray()
    for chunk in chunks:
        nominal = struct.unpack("<I", chunk[8:12])[0]
        table += struct.pack("<III", XCURSOR_IMAGE_TYPE, nominal, position)
        body += chunk
        position += len(chunk)
    return (struct.pack("<4sIII", XCURSOR_MAGIC, FILE_HEADER_SIZE,
                        XCURSOR_VERSION, len(chunks)) + bytes(table) + bytes(body))


def build_shape(shape_dir, body, outline):
    """One shape, every size, every animation frame."""
    frames = json.loads((shape_dir / "metadata.json").read_text())
    # The hotspot is recorded against the rendered size, not the nominal one.
    reference = pixel_size(frames[0]["nominal_size"])
    fraction_x = frames[0]["hotspot_x"] / reference
    fraction_y = frames[0]["hotspot_y"] / reference

    artwork = [recolour((shape_dir / frame["filename"]).read_text(), body, outline)
               for frame in frames]

    chunks = []
    for nominal in NOMINAL_SIZES:
        size = pixel_size(nominal)
        for frame, svg_text in zip(frames, artwork):
            chunks.append(image_chunk(
                nominal, size, int(fraction_x * size), int(fraction_y * size),
                frame.get("delay", DEFAULT_DELAY), render(svg_text, size)))
    return shape_dir.name, xcursor_file(chunks)


def build_hyprcursors(output_dir, body, outline):
    """Rebuild the Hyprland cursors by swapping the colours inside each zip."""
    target = output_dir / "hyprcursors"
    target.mkdir(parents=True, exist_ok=True)
    for archive in sorted((SOURCE / "hyprcursors").glob("*.hlc")):
        with zipfile.ZipFile(archive) as original, \
                zipfile.ZipFile(target / archive.name, "w", zipfile.ZIP_DEFLATED) as rebuilt:
            for member in original.infolist():
                content = original.read(member)
                if member.filename.endswith(".svg"):
                    content = recolour(content.decode(), body, outline).encode()
                rebuilt.writestr(member.filename, content)


def aliases():
    """The source theme points most of its names at the handful of shapes that
    really exist — `left_ptr` and a pile of bare hashes all resolve to `default`.
    Those names are links, not shapes, so they are neither rendered nor counted."""
    return {entry.name: os.readlink(entry)
            for entry in sorted((SOURCE / "cursors").iterdir()) if entry.is_symlink()}


def build(theme_dir, workers):
    name = theme_dir.name
    colors = read_palette(theme_dir)
    body = colors["accent"]
    outline = colors["background"]

    output_dir = INSTALL_ROOT / f"omaricethcy-{name}"
    if output_dir.exists():
        shutil.rmtree(output_dir)
    (output_dir / "cursors").mkdir(parents=True)

    linked = aliases()
    shapes = sorted(path for path in (SOURCE / "cursors_scalable").iterdir()
                    if (path / "metadata.json").is_file() and path.name not in linked)
    print(f"{name}: {body} on {outline}, {len(shapes)} shapes "
          f"x {len(NOMINAL_SIZES)} sizes, {len(linked)} aliases", flush=True)

    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
        futures = [pool.submit(build_shape, shape, body, outline) for shape in shapes]
        for done, future in enumerate(concurrent.futures.as_completed(futures), 1):
            shape_name, content = future.result()
            (output_dir / "cursors" / shape_name).write_bytes(content)
            print(f"\r  {done}/{len(shapes)} shapes", end="", flush=True)
    print()

    for alias, target in linked.items():
        (output_dir / "cursors" / alias).symlink_to(target)
    build_hyprcursors(output_dir, body, outline)

    (output_dir / "index.theme").write_text(
        f"[Icon Theme]\nName=Omaricethcy {name.capitalize()}\n"
        f"Comment=Volantes cursors in the {name} accent\nInherits=Adwaita\n")
    (output_dir / "manifest.hl").write_text(
        f'name = Omaricethcy {name.capitalize()}\n'
        f'description = Volantes cursors in the {name} accent\n'
        f'version = 1\ncursors_directory = hyprcursors\n')
    print(f"  wrote {output_dir}")


def main():
    global SOURCE
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("themes", nargs="*")
    parser.add_argument("--source", type=pathlib.Path, default=SOURCE,
                        help=f"cursor theme to recolour (default {SOURCE})")
    parser.add_argument("--workers", type=int, default=min(16, (os.cpu_count() or 4) * 2))
    arguments = parser.parse_args()
    SOURCE = arguments.source

    for command in ("rsvg-convert", "magick"):
        if not shutil.which(command):
            sys.exit(f"{command} is required")
    if not (SOURCE / "cursors_scalable").is_dir():
        sys.exit(f"{SOURCE} has no cursors_scalable/ — install catppuccin-cursors-mocha")

    names = arguments.themes or sorted(
        path.name for path in (REPOSITORY / "themes").iterdir() if path.is_dir())
    for name in names:
        theme_dir = REPOSITORY / "themes" / name
        if not theme_dir.is_dir():
            sys.exit(f"no such theme: {name}")
        build(theme_dir, arguments.workers)


if __name__ == "__main__":
    main()
